# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# All variables exposed to the React frontend must start with VITE_
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ==============================================================================
# BACKEND CONFIGURATION (Vercel Serverless Functions)
# These variables are NEVER exposed to the client. Keep them secure!
# ==============================================================================
# AWS SES Config
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com

# Firebase Admin SDK credentials (for token verification and backend DB access)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: Ensure double quotes around private key and format newline characters appropriately (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
